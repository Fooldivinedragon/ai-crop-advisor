# Copy this file to .env and fill in ONE of the keys below.
# .env is private - never share it or upload it to GitHub.

# Free Gemini key for testing: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Claude key (paid) for the final version: https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: force a provider ("gemini" or "claude") or change the Gemini model
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-3.6-flash
